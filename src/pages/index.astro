---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length > 0 && (
        <form
          class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 md:grid-cols-[1fr_16rem_auto] md:items-end"
          data-testid="game-filters"
          aria-label="Filter games"
        >
          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-300">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="text-sm font-semibold text-slate-200">
            <span class="mb-3 block">Publisher</span>
            <select
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 font-normal text-slate-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </label>

          <button
            type="reset"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters"
          >
            Clear filters
          </button>
        </form>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <p class="mb-4 text-sm text-slate-400" data-testid="filter-result-count" aria-live="polite">
            Showing {games.length} games
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="no-filter-results" role="status" aria-live="polite">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  filterForm?.addEventListener('input', () => {
    const selectedCategories = new Set(
      Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
        .map((input) => input.value),
    );
    const publisherId = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
    let visibleCount = 0;

    gameCards.forEach((card) => {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.gameCategoryId ?? '');
      const publisherMatches =
        publisherId === '' || card.dataset.gamePublisherId === publisherId;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      visibleCount += visible ? 1 : 0;
    });

    if (resultCount) {
      resultCount.textContent = `Showing ${visibleCount} games`;
    }
    noResults?.classList.toggle('hidden', visibleCount > 0);
  });

  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(() => filterForm.dispatchEvent(new Event('input')));
  });
</script>
